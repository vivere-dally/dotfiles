{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/bun\" \"$HOME/.local/share/llm-capabilities/src/ste/cli.ts\"",
            "timeout": 15,
            "statusMessage": "STE check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/bun\" \"$HOME/.local/share/llm-capabilities/src/ste/cli.ts\"",
            "timeout": 15,
            "statusMessage": "STE check"
          }
        ]
      }
    ]
  }
}
