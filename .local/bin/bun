#!/usr/bin/env bash
set -euo pipefail

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ ! -s $NVM_DIR/nvm.sh ]]; then
    echo "bun: nvm is not installed in $NVM_DIR" >&2
    exit 127
fi

set +u
# shellcheck source=/dev/null
. "$NVM_DIR/nvm.sh"
set -u

if ! node_path=$(nvm which default 2>/dev/null); then
    echo "bun: nvm's default Node version is not installed" >&2
    exit 127
fi
bun_path="$(dirname "$node_path")/bun"
if [[ ! -x $bun_path ]]; then
    echo "bun: Bun is not installed for nvm's default Node version" >&2
    exit 127
fi

exec "$bun_path" "$@"
